import java.util.*;
import java.io.*;

public class Solution {

    static int diagonalDifference(List<List<Integer>> arr) {
        int n = arr.size();

        int primarySum = 0;   // top-left to bottom-right
        int secondarySum = 0; // top-right to bottom-left

        for (int i = 0; i < n; i++) {
            primarySum += arr.get(i).get(i);
            secondarySum += arr.get(i).get(n - 1 - i);
        }

        return Math.abs(primarySum - secondarySum);
    }

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);

        int n = Integer.parseInt(scan.nextLine().trim());

        List<List<Integer>> arr = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String[] tokens = scan.nextLine().trim().split(" ");
            List<Integer> row = new ArrayList<>();
            for (String token : tokens) {
                row.add(Integer.parseInt(token));
            }
            arr.add(row);
        }

        int result = diagonalDifference(arr);

        System.out.println(result);

        scan.close();
    }
}
