import java.io.*;
import java.util.*;

public class Solution {

    public static long[] maxSubarray(int[] arr) {

        // Kadane's algorithm
        long current = arr[0];
        long maxSubarray = arr[0];

        // Maximum subsequence
        long positiveSum = 0;
        int maxElement = arr[0];

        for (int num : arr) {

            // Maximum subsequence
            if (num > 0) {
                positiveSum += num;
            }

            maxElement = Math.max(maxElement, num);
        }

        // Maximum subarray
        for (int i = 1; i < arr.length; i++) {
            current = Math.max((long) arr[i], current + arr[i]);
            maxSubarray = Math.max(maxSubarray, current);
        }

        long maxSubsequence;

        if (positiveSum > 0) {
            maxSubsequence = positiveSum;
        } else {
            maxSubsequence = maxElement;
        }

        return new long[]{maxSubarray, maxSubsequence};
    }

    public static void main(String[] args) throws Exception {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        for (int test = 0; test < t; test++) {

            int n = sc.nextInt();

            int[] arr = new int[n];

            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
            }

            long[] result = maxSubarray(arr);

            System.out.println(result[0] + " " + result[1]);
        }

        sc.close();
    }
}
