import java.util.*;

class Solution {
    public String largestNumber(int[] nums) {
        String[] strs = new String[nums.length];
        for (int i = 0; i < nums.length; i++) {
            strs[i] = String.valueOf(nums[i]);
        }

        // Sort so that for any two strings a, b: (a+b) should come before (b+a)
        // if (a+b) represents a larger number than (b+a)
        Arrays.sort(strs, (a, b) -> (b + a).compareTo(a + b));

        // Edge case: if the largest number is "0", all numbers must be zero
        if (strs[0].equals("0")) {
            return "0";
        }

        StringBuilder sb = new StringBuilder();
        for (String s : strs) {
            sb.append(s);
        }

        return sb.toString();
    }
}
